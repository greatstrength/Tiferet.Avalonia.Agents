<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Tiferet.Avalonia.Agents.Assets.Controls">

  <Style Selector="controls|MarkdownBlock">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Name="PART_ContentPanel" Spacing="4" />
      </ControlTemplate>
    </Setter>
  </Style>

</Styles>
