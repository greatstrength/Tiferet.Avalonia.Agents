<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctx="using:Tiferet.Avalonia.Agents.Contexts"
             xmlns:domain="using:Tiferet.Avalonia.Agents.Domain"
             xmlns:controls="using:Tiferet.Avalonia.Agents.Assets.Controls"
             x:Class="Tiferet.Avalonia.Agents.Assets.Views.ChatView"
             x:DataType="ctx:ChatViewModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://Tiferet.Avalonia.Agents/Assets/Styles/AgentTheme.axaml" />
  </UserControl.Styles>

  <DockPanel>
    <!-- Header with export buttons -->
    <Border DockPanel.Dock="Top"
            Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
          <Button Name="CopyMarkdownButton"
                  Content="Copy MD"
                  FontSize="12"
                  Padding="8,4" />
          <Button Name="CopyJsonButton"
                  Content="Copy JSON"
                  FontSize="12"
                  Padding="8,4" />
        </StackPanel>
        <TextBlock Text="{Binding AgentName}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Message input (bottom-docked) -->
    <controls:MessageInput DockPanel.Dock="Bottom"
                           Text="{Binding CurrentInput, Mode=TwoWay}"
                           SendCommand="{Binding SendMessageCommand}"
                           IsInputEnabled="{Binding !IsSending}" />

    <!-- Message list -->
    <ScrollViewer Name="MessageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  Padding="8">
      <StackPanel Spacing="0">
        <!-- Chat messages -->
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="domain:ChatMessage">
              <controls:ChatBubble Role="{Binding Role}"
                                   Content="{Binding Content}"
                                   IsStreaming="{Binding IsStreaming}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pending tool approval cards -->
        <ItemsControl ItemsSource="{Binding PendingApprovals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ctx:ToolApprovalViewModel">
              <controls:ToolCallCard ToolName="{Binding ToolCall.Name}"
                                     Arguments="{Binding ToolCall.Arguments}"
                                     ToolCallId="{Binding ToolCall.Id}"
                                     Status="{Binding Status}"
                                     ApproveCommand="{Binding ApproveCommand}"
                                     DenyCommand="{Binding DenyCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>

</UserControl>
