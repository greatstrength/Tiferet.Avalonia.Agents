<Project>

  <PropertyGroup>
    <Authors>greatstrength</Authors>
    <Company>greatstrength</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/greatstrength/Tiferet.Avalonia.Agents</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/greatstrength/Tiferet.Avalonia.Agents</PackageProjectUrl>
    <Version>1.0.0-beta.1</Version>
    <!-- Default: nothing is packable. Source projects opt in by overriding to true. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
